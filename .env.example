# Flask Configuration
FLASK_SECRET_KEY=replace-with-a-random-secret-key-in-production
FLASK_ENV=production
PORT=10000

# Google reCAPTCHA Configuration
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Twilio SMS OTP Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# Google OAuth Configuration (Optional, for Google Drive integration)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PROJECT_ID=your_google_project_id

# Database Configuration (Optional, default is local frvs.db)
# DATABASE_PATH=/var/data/frvs.db
